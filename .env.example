# ─────────────────────────────────────────────────────────────
# Pamir Construct — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# All secrets are server-side only (no NEXT_PUBLIC_ prefix).
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://pamirconstruct.md

# ── Lead notifications (choose any subset; blanks are skipped) ──

# Telegram: create a bot via @BotFather, then add bot to a chat/channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (optional — wire your provider in src/app/api/lead/route.ts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=sales@pamirconstruct.md

# ── Optional: swap the local content layer for a headless CMS later ──
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=
