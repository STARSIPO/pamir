# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Бот-уведомитель (получить токен: @BotFather → /newbot) ---
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot, или напишите /start своему боту)
ADMIN_ID=

# --- Telegram userbot для чтения чатов/каналов (https://my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# Номер телефона аккаунта в международном формате, например +79991234567
TG_PHONE=
# Файл сессии Telethon (будет создан data/userbot.session)
TG_SESSION=data/userbot

# --- Планировщик ---
# Интервал опроса сайтов в секундах (минимум 30), к нему добавляется случайный разброс ±POLL_JITTER
POLL_INTERVAL=180
POLL_JITTER=0.2

# --- Источники: true / false ---
SOURCE_FL=true
SOURCE_KWORK=true
# Habr Freelance закрыт 28.02.2025 — источник выключен; модуль оставлен на случай перезапуска сайта
SOURCE_HABR=false
SOURCE_FREELANCER=true
SOURCE_TELEGRAM=true

# --- Бюджет ---
# Минимальный бюджет в рублях (0 — не фильтровать). Иностранные валюты пересчитываются по курсам из config.yaml
MIN_BUDGET=0
# true — не присылать заказы без указанного бюджета («договорная»)
SKIP_NO_BUDGET=false

# --- Отправка ---
# Пауза между сообщениями в Telegram, секунды
SEND_DELAY=1.5

# --- Сеть ---
HTTP_TIMEOUT=20
HTTP_RETRIES=3
# Свой User-Agent (пусто — случайный реалистичный браузерный)
USER_AGENT=
# Прокси для запросов к сайтам, если Kwork/FL.ru блокируют ваш IP (например, вы не в РФ/СНГ):
# http://user:password@host:port  (пусто — без прокси)
SITES_PROXY=

# --- Логи и файлы ---
LOG_LEVEL=INFO
DB_PATH=data/orders.db
LOGS_DIR=logs
